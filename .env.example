# ============================================================
# Amazon Creators API（PA-API 5.0 の後継。アソシエイト・セントラルで発行）
# ============================================================
# 認証情報ID / シークレット（アソシエイト・セントラル > ツール > Creators API で作成）
AMAZON_CREATORS_CREDENTIAL_ID=your-credential-id
AMAZON_CREATORS_CREDENTIAL_SECRET=your-credential-secret
# 認証情報のバージョン（発行時に表示される。日本は 3.3 または 2.3）
AMAZON_CREATORS_CREDENTIAL_VERSION=3.3
# トラッキングID（Partner Tag）
AMAZON_PARTNER_TAG=yourtag-22
# マーケットプレイス
AMAZON_MARKETPLACE=www.amazon.co.jp

# ============================================================
# Selling Partner API（任意。出品者アカウントがある場合のみ。出品者数の取得に使う）
# ============================================================
SP_API_ENABLED=false
SP_API_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
SP_API_LWA_CLIENT_SECRET=your-lwa-client-secret
SP_API_REFRESH_TOKEN=Atzr|xxxxxxxx
# na / eu / fe（日本は fe）
SP_API_REGION=fe
# 省略時は AMAZON_MARKETPLACE から決定（日本: A1VC38T7YXB528）
SP_API_MARKETPLACE_ID=A1VC38T7YXB528

# ============================================================
# WordPress（任意。自分のブログに下書きを作る場合のみ。settings.ENABLE_WORDPRESS_DRAFT=True も必要）
# ============================================================
WP_BASE_URL=https://example.com
WP_USERNAME=your-wp-user
# WordPress のユーザー設定で発行する「アプリケーションパスワード」
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
